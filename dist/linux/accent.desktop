[Desktop Entry]
Type=Application
Name=Accent
Comment=Hold a letter, press Space, pick an accent character
Exec=accent --settings
Icon=accent
Terminal=false
Categories=Utility;Accessibility;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-UsesNotifications=false
Actions=Settings;Quit;

[Desktop Action Settings]
Name=Settings
Exec=accent --settings

[Desktop Action Quit]
Name=Quit Accent
Exec=accent --quit
