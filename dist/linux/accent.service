[Unit]
Description=Accent accent character picker
Documentation=https://github.com/BenLewies/Accent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/accent
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/bin:/usr/local/bin:%h/.local/bin

[Install]
WantedBy=graphical-session.target
