# Maintainer: Victor Masson <victor.massonv@gmail.com>
# Prebuilt Accent from the tagged GitHub release. The tarball is pinned by
# sha256 below and carries a Sigstore build-provenance attestation:
#   gh attestation verify accent-linux-x86_64.tar.gz --repo BenLewies/Accent
pkgname=accent-bin
_pkgname=accent
pkgver=1.3.0
pkgrel=1
pkgdesc="Accent character picker: hold a letter, press Space, pick an accent (evdev grab + uinput injection)"
arch=('x86_64')
url="https://github.com/BenLewies/Accent"
license=('MIT')
depends=('libxkbcommon' 'libevdev' 'libx11' 'libxcb' 'hicolor-icon-theme' 'systemd')
optdepends=('wl-clipboard: emergency paste fallback when the keymap cannot be extended')
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$_pkgname.install"
source=("$_pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/accent-linux-x86_64.tar.gz")
# Refresh after tagging: `updpkgsums` (pacman-contrib). Must match SHA256SUMS on the release.
sha256sums=('c0950e158ec086532f65302f2dabe109566ddef2e4b4849b352e27de591e9c95')

package() {
  cd "$srcdir/accent-linux-x86_64"
  install -Dm755 accent "$pkgdir/usr/bin/accent"

  # systemd --user unit (enable with: systemctl --user enable --now accent)
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/accent --daemon|' accent.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/accent.service"

  # Group "input" may read keyboards and open /dev/uinput; uinput loads at boot.
  install -Dm644 60-accent.rules "$pkgdir/usr/lib/udev/rules.d/60-accent.rules"
  echo uinput | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/accent.conf"

  install -Dm644 accent.desktop "$pkgdir/usr/share/applications/accent.desktop"
  install -Dm644 accent.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/accent.svg"
  install -Dm644 accent-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/accent.png"
  install -Dm644 accent-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/accent.png"
  for notice in LICENSE NOTICE.md THIRD_PARTY_NOTICES.md RUST_DEPENDENCY_LICENSES.txt; do
    install -Dm644 "$notice" "$pkgdir/usr/share/licenses/$pkgname/$notice"
  done
}
