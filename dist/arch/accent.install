post_install() {
  modprobe uinput 2>/dev/null || true
  cat <<'MSG'
==> Accent: two one-time steps for your user
    sudo usermod -aG input "$USER"        # read keyboards + open /dev/uinput
    reboot                                # systemd --user must pick up the group
    systemctl --user enable --now accent
    Group "input" can read every keystroke on this machine: trusted users only.
MSG
}

post_upgrade() {
  echo "==> Accent: restart the daemon with: systemctl --user restart accent"
}

post_remove() {
  cat <<'MSG'
==> Accent removed. Optional cleanup for your user:
    systemctl --user disable --now accent    # if still enabled
    sudo gpasswd -d "$USER" input                 # if nothing else needs it
    rm -rf ~/.config/xkb/symbols/accent ~/.config/accent
MSG
}
